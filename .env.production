
# Application Configuration
NODE_ENV=production
REACT_APP_ENV=production
REACT_APP_NAME=Malio Email Client
REACT_APP_VERSION=1.0.0
PORT=443
HTTPS=true

# API Configuration
REACT_APP_API_BASE_URL=https://api.malio.com/api/v1
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3

# Authentication & Security
REACT_APP_JWT_SECRET=your_super_secure_jwt_secret_production_key_change_this
JWT_EXPIRES_IN=12h
REACT_APP_SESSION_TIMEOUT=1800000
REACT_APP_MAX_LOGIN_ATTEMPTS=3
REACT_APP_LOCKOUT_DURATION=1800000
REACT_APP_PASSWORD_MIN_LENGTH=12
REACT_APP_REQUIRE_2FA=true
REACT_APP_ALLOW_GUEST_ACCESS=false

# Email Service Configuration
EMAIL_SERVICE_PROVIDER=aws_ses
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_access_key
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_key
SMTP_FROM_NAME=Malio
SMTP_FROM_EMAIL=noreply@malio.com

# Database Configuration
DATABASE_URL=postgresql://malio_prod:secure_prod_password@prod-db.malio.com:5432/malio_prod
DATABASE_SSL=true
DATABASE_LOGGING=false
DATABASE_SYNC=false
DATABASE_MIGRATIONS_RUN=false

# Redis Configuration
REDIS_URL=redis://prod-redis.malio.com:6379
REDIS_PASSWORD=secure_redis_password
REDIS_DB=0
REDIS_CACHE_TTL=7200

# File Storage Configuration
STORAGE_TYPE=aws_s3
AWS_S3_BUCKET=malio-attachments-prod
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=your_s3_access_key
AWS_S3_SECRET_ACCESS_KEY=your_s3_secret_key
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip
ATTACHMENT_VIRUS_SCAN=true

# Email Limits & Quotas
MAX_ATTACHMENT_SIZE_MB=100
MAX_EMAILS_PER_DAY=5000
DEFAULT_MAILBOX_SIZE_MB=5120
MAX_RECIPIENTS_PER_EMAIL=500
MAX_EMAIL_SIZE_MB=50

# Logging Configuration
LOG_LEVEL=error
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/malio/app.log
LOG_MAX_FILES=30
LOG_MAX_SIZE=100m

# External Services
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_prod
REACT_APP_MICROSOFT_CLIENT_ID=your_microsoft_client_id_prod
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_prod

# Monitoring & Analytics
REACT_APP_ANALYTICS_ENABLED=true
REACT_APP_ERROR_TRACKING_ENABLED=true
SENTRY_DSN=https://your_sentry_dsn_prod@sentry.io/project_id

# Security Headers
REACT_APP_CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:
REACT_APP_CORS_ORIGIN=https://malio.com,https://www.malio.com

# Feature Flags
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_CALENDAR=true
REACT_APP_ENABLE_TASKS=true
REACT_APP_ENABLE_CONTACTS=true
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_VIDEO_CALLS=true

# Development Tools
REACT_APP_DEBUG_MODE=false
REACT_APP_MOCK_API=false
REACT_APP_SHOW_DEV_TOOLS=false
GENERATE_SOURCEMAP=false

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/malio.crt
SSL_KEY_PATH=/etc/ssl/private/malio.key

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=malio-backups-prod
