# Application Configuration
NODE_ENV=development
REACT_APP_ENV=development
REACT_APP_NAME=Malio Email Client
REACT_APP_VERSION=1.0.0
PORT=3000
HTTPS=false

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3

# Authentication & Security
REACT_APP_JWT_SECRET=dev_jwt_secret_key_change_in_production_12345
JWT_EXPIRES_IN=24h
REACT_APP_SESSION_TIMEOUT=1800000
REACT_APP_MAX_LOGIN_ATTEMPTS=5
REACT_APP_LOCKOUT_DURATION=900000
REACT_APP_PASSWORD_MIN_LENGTH=8
REACT_APP_REQUIRE_2FA=false
REACT_APP_ALLOW_GUEST_ACCESS=true

# Email Service Configuration
EMAIL_SERVICE_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dev@localhost
SMTP_PASS=dev_password
SMTP_FROM_NAME=Malio Development
SMTP_FROM_EMAIL=noreply@malio-dev.com

# Database Configuration
DATABASE_URL=postgresql://malio_dev:dev_password@localhost:5432/malio_dev
DATABASE_SSL=false
DATABASE_LOGGING=true
DATABASE_SYNC=true
DATABASE_MIGRATIONS_RUN=true

# Redis Configuration (for sessions, cache)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip
ATTACHMENT_VIRUS_SCAN=false

# Email Limits & Quotas
MAX_ATTACHMENT_SIZE_MB=50
MAX_EMAILS_PER_DAY=1000
DEFAULT_MAILBOX_SIZE_MB=1024
MAX_RECIPIENTS_PER_EMAIL=100
MAX_EMAIL_SIZE_MB=25

# Logging Configuration
LOG_LEVEL=debug
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m

# External Services
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_dev
REACT_APP_MICROSOFT_CLIENT_ID=your_microsoft_client_id_dev
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_dev

# Monitoring & Analytics
REACT_APP_ANALYTICS_ENABLED=false
REACT_APP_ERROR_TRACKING_ENABLED=true
SENTRY_DSN=https://your_sentry_dsn_dev@sentry.io/project_id

# Security Headers
REACT_APP_CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'
REACT_APP_CORS_ORIGIN=http://localhost:3000

# Feature Flags
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_CALENDAR=true
REACT_APP_ENABLE_TASKS=true
REACT_APP_ENABLE_CONTACTS=true
REACT_APP_ENABLE_CHAT=false
REACT_APP_ENABLE_VIDEO_CALLS=false

# Development Tools
REACT_APP_DEBUG_MODE=true
REACT_APP_MOCK_API=false
REACT_APP_SHOW_DEV_TOOLS=true
GENERATE_SOURCEMAP=true

ws 


# ===========================================
# .env.example - Template for team members
# ===========================================

# Copy this file to .env.local and fill in your values

# Application Configuration
NODE_ENV=development
REACT_APP_ENV=development
REACT_APP_NAME=Malio Email Client
PORT=3000

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Authentication
REACT_APP_JWT_SECRET=your_jwt_secret_here
REACT_APP_SESSION_TIMEOUT=1800000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Email Service
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password

# External Services (Optional)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
REACT_APP_MICROSOFT_CLIENT_ID=your_microsoft_client_id
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ===========================================
# .gitignore additions for security
# ===========================================

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads & temporary files
uploads/
temp/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db