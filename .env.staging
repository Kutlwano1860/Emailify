
# Application Configuration
NODE_ENV=staging
REACT_APP_ENV=staging
REACT_APP_NAME=Malio Email Client (Staging)
REACT_APP_VERSION=1.0.0-staging
PORT=3000
HTTPS=true

# API Configuration
REACT_APP_API_BASE_URL=https://staging-api.malio.com/api/v1
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3

# Authentication & Security
REACT_APP_JWT_SECRET=staging_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h
REACT_APP_SESSION_TIMEOUT=1800000
REACT_APP_MAX_LOGIN_ATTEMPTS=5
REACT_APP_LOCKOUT_DURATION=900000
REACT_APP_PASSWORD_MIN_LENGTH=8
REACT_APP_REQUIRE_2FA=true
REACT_APP_ALLOW_GUEST_ACCESS=true

# Email Service Configuration
EMAIL_SERVICE_PROVIDER=aws_ses
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_access_key_staging
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_key_staging
SMTP_FROM_NAME=Malio Staging
SMTP_FROM_EMAIL=noreply@staging.malio.com

# Database Configuration
DATABASE_URL=postgresql://malio_staging:staging_password@staging-db.malio.com:5432/malio_staging
DATABASE_SSL=true
DATABASE_LOGGING=true
DATABASE_SYNC=false
DATABASE_MIGRATIONS_RUN=true

# Feature Flags
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_CALENDAR=true
REACT_APP_ENABLE_TASKS=true
REACT_APP_ENABLE_CONTACTS=true
REACT_APP_ENABLE_CHAT=false
REACT_APP_ENABLE_VIDEO_CALLS=false

# Development Tools
REACT_APP_DEBUG_MODE=true
REACT_APP_MOCK_API=false
REACT_APP_SHOW_DEV_TOOLS=true
GENERATE_SOURCEMAP=true